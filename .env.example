SECRET_KEY=change-me-to-a-random-string
# 敏感字段加密专用密钥（可选；留空则用 SECRET_KEY 派生）。一旦设置并写入数据后不可变更
# 注意：变更本值或 SECRET_KEY 后，库里已有的 Key / 代理密码将无法解密（按空值处理并记 error 日志）
ENCRYPTION_KEY=
# muse-spark 等 Responses reasoning 密文解密（可选，Fernet 形态 gAAAA...）
# 优先 REASONING_DECRYPT_KEY，其次回落 ENCRYPTION_KEY / SECRET_KEY 派生
REASONING_DECRYPT_KEY=
DEBUG=false
# 逗号分隔的允许 Host。生产建议显式列出实际域名/IP；
# 保留 * 可沿用旧行为（会用一条启动警告提示 Host 头校验失效）
ALLOWED_HOSTS=*
# 跨域：all-in-one 镜像下前端由本服务同源托管，无需跨域，生产建议 false。
# 确需跨域时用 CORS_ALLOWED_ORIGINS 显式列出来源（逗号分隔），不要用通配。
# 本地前后端分离开发（Next.js :3000 → 后端 :8000）示例：
#   CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=

DATA_DIR=./data
# SQLite 文件路径（可选；留空则使用 $DATA_DIR/db.sqlite3 的默认值）
DATABASE_PATH=

# 管理后台账号 / token（API 认证令牌）
# 【必改】出厂默认值 admin123 / dev-admin-token 在 DEBUG=false 下会拒绝启动；
# 泄露后可通过 ?reveal=1 明文回读全部上游 Key。请替换为随机值：
#   python -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@#%^&*-_') for _ in range(20)))"
#   python -c "import secrets;print('n2a-'+secrets.token_urlsafe(32))"
# 轮换：ADMIN_TOKEN 支持多值（逗号分隔），新旧值在过渡期内同时有效，
# 确认客户端都切走后再从环境变量里移除旧值。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_TOKEN=change-me

NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

DEFAULT_NVIDIA_RPM=0

# 全局并发上限的**初始默认**（可在后台设置页实时调整，无需重启）：
#   MAX_CONCURRENT_REQUESTS  在途请求上限，防单实例被并发压垮（后台优先，环境变量回落）
#   MAX_ROUTES_PER_REQUEST   单请求最大并行线路数的默认值（可在后台按渠道覆盖）
#   MAX_CONCURRENT_UPSTREAM  全平台同时打开的上游 HTTP 连接数上限（跨请求 socket 阀门）
#                             默认 0=不限制；Windows SelectorEventLoop 的 select 有 ~512 fd 硬限制，
#                             受限环境才需调小（如 300），余量不足时请求降级为更少线路
MAX_CONCURRENT_REQUESTS=500
# 默认从 80 降到 8：每条线路都是一个真实的上游并发流，而 agent 客户端的工具调用
# 是原子具现的（N 个子代理同一毫秒派发）——80 × 6 = 480 条同时流会把上游打到掐流。
# 注意 SystemSetting 里的**按渠道覆盖值优先于本默认**，要生效需在控制台设置页调。
MAX_ROUTES_PER_REQUEST=8
MAX_CONCURRENT_UPSTREAM=0

# 单进程契约（默认强制）。并发闸门、登录限速、运行时参数缓存都是**进程内**状态，
# 多 worker / 多实例挂同一个 data 卷会让它们静默失效（不报错，只是保护消失）。
# 启动时用 data/.gateway.lock 做 OS 级文件锁检查，发现第二个实例直接拒绝启动。
# 只有在你已经把上述状态外置（Redis / PostgreSQL）时才设为 true 放行。
# ALLOW_MULTI_PROCESS=true

# 注意：**没有 ASGI_THREADS 这个变量**。曾经本文件与 config/asgi.py 提供过它，
# 但 asgiref 与 Django 都不读取（已安装包里 grep 零命中），设成任何值都无效。
# 真实模型是：本项目所有入口都是同步视图，Django 用
# sync_to_async(thread_sensitive=True) 包装，落到 asgiref 硬编码的
# ThreadPoolExecutor(max_workers=1) —— 全系统共用一条线程，无法通过配置加宽。
# 详见 config/asgi.py 顶部说明与 docs/architecture-review-2026-09b.md。

# 上游/代理超时默认值（可在后台按渠道覆盖）：
#   PROXY_TIMEOUT=10            代理测速超时（秒）
#   UPSTREAM_CONNECT_TIMEOUT=10 上游连接超时（秒，DNS/建连/代理握手）
#   UPSTREAM_READ_TIMEOUT=0     非流式请求的上游读超时（秒，**0=不限制，默认**）
#     代价：read 超时管不住"一直在动却永远不结束"的上游；而本项目每个入口都是
#     同步视图、共用 asgiref 硬编码的单线程执行器（见上方 ASGI_THREADS 说明），
#     一条挂死的非流式请求冻结的是整个网关。兜底见下面的 upstream_total_timeout。
PROXY_TIMEOUT=10
UPSTREAM_CONNECT_TIMEOUT=10
UPSTREAM_READ_TIMEOUT=0

# 非流式竞速的**总墙钟**上限：运行时参数 `upstream_total_timeout`，默认 3600 秒
# （0=不限制）。它没有环境变量形式，在后台「设置」页按渠道调整。

# 流式保活/掐线默认值（可在后台按渠道覆盖）：
#   stream_heartbeat_interval=20      上游静默多少秒向客户端发 SSE 心跳（0=关闭）
#   stream_idle_timeout=0             胜出后无真实内容的静默判死上限（**0=不限制，默认**）
#   stream_content_idle_timeout=0     已产出内容后的静默上限（**0=不限制，默认**）
#   stream_max_duration=3600          整条流总时长上限（秒）。**不是静默判死**：持续吐字
#                                     的慢模型不会被它杀，只挡"每 19 秒滴一个字节"的僵尸流
#   stream_first_byte_timeout=180     竞速阶段等待首个 SSE 块的最长超时
# 以上几个与 retry_count=0（默认不重试）、thinking 等均为系统运行时参数，在后台「设置」页编辑即可，无需环境变量。

LOG_LEVEL=INFO

# 前端
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
