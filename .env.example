SECRET_KEY=change-me-to-a-random-string
# 敏感字段加密专用密钥（可选；留空则用 SECRET_KEY 派生）。一旦设置并写入数据后不可变更
# 注意：变更本值或 SECRET_KEY 后，库里已有的 Key / 代理密码将无法解密（按空值处理并记 error 日志）
ENCRYPTION_KEY=
DEBUG=false
# 逗号分隔的允许 Host。生产建议显式列出实际域名/IP；
# 保留 * 可沿用旧行为（会用一条启动警告提示 Host 头校验失效）
ALLOWED_HOSTS=*
# 跨域：all-in-one 镜像下前端由本服务同源托管，无需跨域，生产建议 false。
# 确需跨域时用 CORS_ALLOWED_ORIGINS 显式列出来源（逗号分隔），不要用通配。
# 本地前后端分离开发（Next.js :3000 → 后端 :8000）示例：
#   CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=

DATA_DIR=./data
# SQLite 文件路径（可选；留空则使用 $DATA_DIR/db.sqlite3 的默认值）
DATABASE_PATH=

# 管理后台账号 / token（API 认证令牌）
# 【必改】出厂默认值 admin123 / dev-admin-token 在 DEBUG=false 下会拒绝启动；
# 泄露后可通过 ?reveal=1 明文回读全部上游 Key。请替换为随机值：
#   python -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@#%^&*-_') for _ in range(20)))"
#   python -c "import secrets;print('n2a-'+secrets.token_urlsafe(32))"
# 轮换：ADMIN_TOKEN 支持多值（逗号分隔），新旧值在过渡期内同时有效，
# 确认客户端都切走后再从环境变量里移除旧值。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_TOKEN=change-me

NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

DEFAULT_NVIDIA_RPM=40

# 平台进程级参数（不是运行时参数，改后需重启生效）：
#   MAX_CONCURRENT_REQUESTS  全局并发闸门（启动时创建信号量）
#   MAX_ROUTES_PER_REQUEST   单请求最大并行线路数的默认值（可在后台按渠道覆盖）
MAX_CONCURRENT_REQUESTS=100
MAX_ROUTES_PER_REQUEST=50

# 上游/代理超时默认值（可在后台按渠道覆盖）：
#   PROXY_TIMEOUT=10            代理测速超时（秒）
#   UPSTREAM_CONNECT_TIMEOUT=10 上游连接超时（秒，DNS/建连/代理握手）
#   UPSTREAM_READ_TIMEOUT=120   非流式请求的上游读超时（秒）
PROXY_TIMEOUT=10
UPSTREAM_CONNECT_TIMEOUT=10
UPSTREAM_READ_TIMEOUT=120

# 流式保活/掐线默认值（可在后台按渠道覆盖）：
#   stream_heartbeat_interval=15   上游静默多少秒向客户端发 SSE 心跳（0=关闭）
#   stream_stall_timeout=300       上游连续无任何数据多少秒判死线（0=不掐断）
#   stream_max_duration=0          整条流总时长上限，防僵尸流（0=不限）
#   stream_first_byte_timeout=60   竞速阶段等待首个 SSE 块的最长超时
# 以上 4 项与 retry_count=1、thinking 等均为系统运行时参数，在后台「设置」页编辑即可，无需环境变量。

LOG_LEVEL=INFO

# 前端
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
